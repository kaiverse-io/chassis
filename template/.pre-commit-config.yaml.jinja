repos:
  # Secret scanning — blocks leaks before they hit the remote
  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.21.2
    hooks:
      - id: gitleaks

  # Python lint, format and types — the project's own uv-locked tools and pyproject config,
  # exactly what `just ci-lint` runs. Mirror repos (ruff-pre-commit, mirrors-mypy) pinned their
  # own older versions and ran mypy non-strict, so a commit could pass here and fail CI.
  - repo: local
    hooks:
      - id: ruff
        name: ruff (uv-locked)
        entry: uv run ruff check --fix
        language: system
        types: [python]
      - id: ruff-format
        name: ruff format (uv-locked)
        entry: uv run ruff format
        language: system
        types: [python]
      - id: mypy
        name: mypy (uv-locked, project config)
        entry: uv run mypy src/
        language: system
        types: [python]
        pass_filenames: false

  # Shell scripts — same pinned shellcheck `just ci-lint` runs
  - repo: local
    hooks:
      - id: shellcheck
        name: shellcheck
        entry: uvx --from shellcheck-py==0.10.0.1 shellcheck
        language: system
        types: [shell]

  # Dockerfile linting
  - repo: https://github.com/hadolint/hadolint
    rev: v2.12.0
    hooks:
      - id: hadolint-docker

  # Conventional commits
  - repo: https://github.com/commitizen-tools/commitizen
    rev: v3.29.0
    hooks:
      - id: commitizen
        stages: [commit-msg]

  # Dependency vulnerability scan (runs on push, not commit — slow)
  - repo: https://github.com/google/osv-scanner
    rev: v1.9.1
    hooks:
      - id: osv-scanner
        stages: [pre-push]

  # Architecture boundary enforcement (slot — fill .importlinter)
  - repo: local
    hooks:
      - id: import-linter
        name: import-linter (architecture boundaries)
        entry: just _lint-imports
        language: system
        types: [python]
        pass_filenames: false

  # Custom semantic rules (opengrep — self-weakening guard + project rules)
  - repo: local
    hooks:
      - id: opengrep
        name: opengrep (self-weakening + project rules)
        # Requires opengrep in PATH — installed by .devcontainer/post-create.sh
        entry: bash -c 'command -v opengrep >/dev/null 2>&1 || { echo "opengrep required — run .devcontainer/post-create.sh"; exit 1; }; opengrep scan --config .opengrep/rules/ . --error --severity ERROR'
        language: system
        pass_filenames: false
        stages: [pre-commit]
