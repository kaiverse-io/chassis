[project]
name = "{{ python_package_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
license = { text = "{{ license }}" }
requires-python = ">={{ python_version }}"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
dependencies = []

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[dependency-groups]
dev = [
    "pytest>=8.3",
    "pytest-cov>=5.0",
    "mypy>=1.11",
    "ruff>=0.6",
    "import-linter>=2.1",
]

[tool.ruff]
target-version = "py{{ python_version | replace('.', '') }}"
line-length = 100

[tool.ruff.lint]
select = ["E", "W", "F", "I", "S", "C901", "UP", "B", "N"]
ignore = ["S101"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S"]

[tool.mypy]
python_version = "{{ python_version }}"
strict = true
ignore_missing_imports = true

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = [
    "--cov={{ python_package_name }}",
    "--cov-report=term-missing",
    "--cov-fail-under=0",
]

[tool.coverage.run]
source = ["{{ python_package_name }}"]
branch = true

[tool.coverage.report]
# Ratchet (bucket B): only increase this value, never decrease it.
fail_under = 0
