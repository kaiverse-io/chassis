name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  ci:
    name: CI
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: astral-sh/setup-uv@v5
        with:
          python-version: "{{ python_version }}"
          enable-cache: true

      - name: Install just
        env:
          # Pinned release binary, not the unpinned upstream install script piped to bash
          # (same as chassis's own CI and post-create.sh).
          # renovate: datasource=github-releases depName=casey/just extractVersion=^(?<version>.*)$
          JUST_VERSION: "1.56.0"
        run: |
          curl --proto '=https' --tlsv1.2 -fsSL --retry 5 --retry-all-errors \
            "https://github.com/casey/just/releases/download/${JUST_VERSION}/just-${JUST_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
            | sudo tar -xz -C /usr/local/bin just

      - name: Install deps
        run: uv sync

      - name: Install gitleaks
        env:
          GITLEAKS_VERSION: "8.21.2"
        run: |
          arch="$(uname -m)"
          case "$arch" in
            x86_64) ga=x64 ;;
            aarch64|arm64) ga=arm64 ;;
            *) echo "unsupported arch: $arch"; exit 1 ;;
          esac
          curl -sSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${ga}.tar.gz" \
            | sudo tar -xz -C /usr/local/bin gitleaks
          gitleaks version

      - name: Install opengrep
        env:
          OPENGREP_VERSION: "1.26.0"
        run: |
          arch="$(uname -m)"
          case "$arch" in
            x86_64) asset=opengrep_manylinux_x86 ;;
            aarch64|arm64) asset=opengrep_manylinux_aarch64 ;;
            *) echo "unsupported arch: $arch"; exit 1 ;;
          esac
          curl -sSL --retry 5 --retry-all-errors \
            "https://github.com/opengrep/opengrep/releases/download/v${OPENGREP_VERSION}/${asset}" \
            -o /tmp/opengrep
          sudo install -m 0755 /tmp/opengrep /usr/local/bin/opengrep
          opengrep --version


      - name: Install lychee
        env:
          # renovate: datasource=github-releases depName=lycheeverse/lychee extractVersion=^lychee-v(?<version>.*)$
          LYCHEE_VERSION: "0.24.2"
        run: |
          arch="$(uname -m)"
          case "$arch" in
            x86_64) la=x86_64 ;;
            aarch64|arm64) la=aarch64 ;;
            *) echo "unsupported arch: $arch"; exit 1 ;;
          esac
          tmp="$(mktemp -d)"
          curl -sSfL --retry 5 --retry-all-errors \
            "https://github.com/lycheeverse/lychee/releases/download/lychee-v${LYCHEE_VERSION}/lychee-${la}-unknown-linux-gnu.tar.gz" \
            | tar -xz -C "$tmp"
          sudo install -m 0755 "$(find "$tmp" -type f -name lychee | head -1)" /usr/local/bin/lychee
          lychee --version

      - name: Lint
        run: just ci-lint

      - name: Test
        run: just ci-test

      - name: Docs
        run: just ci-docs

      - name: Architecture coverage
        run: just ci-arch
