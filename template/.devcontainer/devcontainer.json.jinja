{
  "name": "{{ project_name }}",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // ── Features (pinned — no "lts") ─────────────────────────────────────────
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Node/npm is unconditional, not gated behind include_ts: the AI-usage cockpit
    // (codeburn, lean-ctx, AI Engineer Coach) and the Claude Code CLI itself are all
    // installed via npm in post-create.sh regardless of the project's own language.
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8080],

  // ── Mounts (4-layer model) ────────────────────────────────────────────────
  // Layer 2 — mounted host-state (machine-agnostic, gitignored on host)
  "mounts": [
    // Agent memory — writable (required)
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    // Git identity — read-only
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached,readonly",
    // SSH keys — read-only (create ~/.ssh on host if missing)
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached,readonly"
    // Project-specific credentials — add here as needed:
    //   AWS: "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,consistency=cached,readonly"
    //   GH CLI: "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached,readonly"
  ],

  "remoteUser": "vscode",

  // ── VS Code ───────────────────────────────────────────────────────────────
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker"{% if include_ts %},
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"{% endif %}

      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  }
}
