{
  "name": "{{ project_name }}",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // ── Features (pinned — no "lts") ─────────────────────────────────────────
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Node/npm is unconditional, not gated behind include_ts: the AI-usage cockpit
    // (codeburn, lean-ctx, AI Engineer Coach) and the Claude Code CLI itself are all
    // installed via npm in post-create.sh regardless of the project's own language.
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
    // Project-specific features — add here as needed:
    //   Docker-outside-of-docker — sibling containers, not nested: forwards the HOST's
    //   docker.sock (mount below) rather than running a second Docker daemon in this
    //   one. Only needed if the project's own docker-compose.yml boots services beyond
    //   `app` (a database, other backing services). Only works when the host itself
    //   runs Docker — a no-host-Docker remote devcontainer needs docker-in-docker
    //   instead, a different feature+mount pair. Pair with the socket mount below and
    //   see post-create.sh's socket permission-fix step, which activates automatically
    //   once the mount is present — the socket's host-side ownership rarely matches
    //   this container's pre-baked docker group, so that step is not optional.
    //   `"moby": false` is deliberate, not optional either: the feature defaults to
    //   installing `moby-cli` from packages.microsoft.com, and on a build sandbox that
    //   only allowlists docker.com (a common corporate VPN/proxy shape), that install
    //   fails with a bare "exit code: 100" — apt's generic failure code, with the real
    //   cause hidden unless you rebuild with `--progress=plain`. `moby: false` installs
    //   `docker-ce-cli` from download.docker.com instead, which is the repo that's
    //   actually reachable in that shape of network:
    //     "ghcr.io/devcontainers/features/docker-outside-of-docker:1": { "moby": false }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8080],

  // ── Mounts (4-layer model) ────────────────────────────────────────────────
  // Layer 2 — mounted host-state (machine-agnostic, gitignored on host)
  "mounts": [
    // Agent memory — writable (required)
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    // Claude Code account/session state — a sibling FILE, not inside ~/.claude/ above
    // (oauth account, mcpServers, recent-projects/trust list, onboarding flags).
    // Writable: Claude Code updates it continuously. Requires the file to already
    // exist on host (run Claude Code there at least once first).
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind,consistency=cached",
    // Git identity — read-only
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached,readonly",
    // SSH keys — read-only (create ~/.ssh on host if missing)
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached,readonly",
    // GH CLI auth — read-only. The github-cli feature above installs the `gh` binary;
    // without this mount it has nothing to authenticate with (create ~/.config/gh on
    // host via `gh auth login` if missing).
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached,readonly"
    // Project-specific credentials — add here as needed:
    //   AWS: "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,consistency=cached,readonly"
    //   Docker socket (pairs with docker-outside-of-docker feature above):
    //     "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],

  "remoteUser": "vscode",

  // ── VS Code ───────────────────────────────────────────────────────────────
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker"{% if include_ts %},
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"{% endif %}

      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  }
}
