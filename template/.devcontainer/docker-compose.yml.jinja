# Dev environment for {{ project_name }}.
# Add project-specific services (databases, queues, etc.) below the app service.
services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
    command: sleep infinity
    volumes:
      - ../..:/workspaces:cached
      # Layer 3 — cache volumes (fast rebuilds, never committed)
      - uv-cache:/home/vscode/.cache/uv
      - precommit-cache:/home/vscode/.cache/pre-commit{% if include_ts %}
      - pnpm-cache:/home/vscode/.local/share/pnpm/store{% endif %}
      # Claude Code session transcripts deliberately have NO separate mount here —
      # they fall through to the devcontainer.json ~/.claude bind mount like
      # everything else under ~/.claude. A prior version nested a named Docker
      # volume at .claude/projects, reasoning the parent bind mount isn't durable
      # on remote/cloud devcontainers. In practice that volume lives on the local
      # Docker Desktop VM's own disk, not the host machine's disk — so on a local
      # devcontainer it made session history LESS durable (a rebuild that
      # recreates the volume, e.g. after a devcontainer.json features change,
      # silently orphans every prior session with no host-side trace). See
      # docs/explanation/devcontainer-persistence.md. Revisit only for a project
      # that actually runs on a remote/cloud devcontainer.

    environment:
      UV_LINK_MODE: copy   # volumes are on different filesystems in Docker

# ── Project-specific services (add here) ─────────────────────────────────────
# Example:
#   db:
#     image: postgres:16
#     environment:
#       POSTGRES_USER: {{ python_package_name }}
#       POSTGRES_PASSWORD: localdev
#       POSTGRES_DB: {{ python_package_name }}
#     volumes:
#       - pgdata:/var/lib/postgresql/data

# ── Cache volumes (Layer 3) ───────────────────────────────────────────────────
volumes:
  uv-cache:
  precommit-cache:{% if include_ts %}
  pnpm-cache:{% endif %}
