# Dev environment for {{ project_name }}.
# Add project-specific services (databases, queues, etc.) below the app service.
services:
  app:
    image: mcr.microsoft.com/devcontainers/python:1-{{ python_version }}-bookworm
    command: sleep infinity
    volumes:
      - ../..:/workspaces:cached
      # Layer 3 — cache volumes (fast rebuilds, never committed)
      - uv-cache:/home/vscode/.cache/uv
      - precommit-cache:/home/vscode/.cache/pre-commit{% if include_ts %}
      - pnpm-cache:/home/vscode/.local/share/pnpm/store{% endif %}

      # Claude Code session transcripts — a real Docker volume, not just the
      # devcontainer.json ~/.claude bind mount. That bind mount only persists
      # when ${localEnv:HOME} is itself a durable host path (true on local
      # devcontainers, not guaranteed on remote/cloud ones). Nesting a named
      # volume at .claude/projects specifically guarantees session history
      # survives a rebuild either way — Docker layers the more specific mount
      # inside the parent bind mount.
      - claude-projects:/home/vscode/.claude/projects

    environment:
      UV_LINK_MODE: copy   # volumes are on different filesystems in Docker

# ── Project-specific services (add here) ─────────────────────────────────────
# Example:
#   db:
#     image: postgres:16
#     environment:
#       POSTGRES_USER: {{ python_package_name }}
#       POSTGRES_PASSWORD: localdev
#       POSTGRES_DB: {{ python_package_name }}
#     volumes:
#       - pgdata:/var/lib/postgresql/data

# ── Cache volumes (Layer 3) ───────────────────────────────────────────────────
volumes:
  uv-cache:
  precommit-cache:{% if include_ts %}
  pnpm-cache:{% endif %}

  claude-projects:
